#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
RUNTIME_ROOT="$SCRIPT_DIR/runtime"
ACTUAL_VERIFIER_SHA=$(
  python3 -I -S -B - "$SCRIPT_DIR/verify-runtime.py" <<'PY'
import hashlib
import pathlib
import sys

print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
)
if [ "$ACTUAL_VERIFIER_SHA" != "089362bc86099598050ea0a42277e58d71401f160c508168617fd5cd17de2003" ]; then
  echo "runtime integrity failure: runtime verifier byte drift" >&2
  exit 1
fi
python3 -I -S -B "$SCRIPT_DIR/verify-runtime.py"           --repo "$REPO_ROOT"           --expected-payload-sha "f1d6c70b93ac788c64e9f79cb1a6192dcc453a8c66740d4ca4a94bb5b9ca56ad"           --expected-harness-ref "22dcfb5631087722766463b39858d9a73742b33b" >/dev/null
exec python3 -I -S -B - "$RUNTIME_ROOT" "$@" <<'PY'
import runpy
import sys
import sysconfig
from pathlib import Path

runtime_root = Path(sys.argv[1]).resolve()
argv = sys.argv[2:]
runtime_entrypoint = runtime_root / "entrypoint.py"
stdlib_paths = []
for key in ("stdlib", "platstdlib"):
    value = sysconfig.get_path(key)
    if value:
        stdlib_paths.append(value)
if stdlib_paths:
    dynload = Path(stdlib_paths[0]) / "lib-dynload"
    if dynload.is_dir():
        stdlib_paths.append(str(dynload))
clean_sys_path = []
seen = set()
for value in (str(runtime_root), *stdlib_paths):
    resolved = str(Path(value).resolve())
    if resolved not in seen:
        clean_sys_path.append(resolved)
        seen.add(resolved)
sys.path[:] = clean_sys_path
sys.argv = [str(runtime_entrypoint), *argv]
runpy.run_path(str(runtime_entrypoint), run_name="__main__")
PY
